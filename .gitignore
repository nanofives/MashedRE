*.csv.gz

# --- verify/ convention (cruft triage 2026-07-02, re/diag/cruft_triage_2026-07-02.md) ---
# verify/ ROOT = scratch (ignored); durable cited evidence lives in committed
# subsystem subfolders (verify/boot/, verify/font/, verify/menu_crash/, ...).
/verify/*
!/verify/*/
# The one intended file at verify/ root: the index that makes every citation of a
# verify/ directory resolve to tracked content (see the capture-blob block below).
!/verify/EVIDENCE_MANIFEST.md
# Regenerable capture pools (dir-cited by analysis notes; rebuild via the
# parity / nav-coverage harnesses — do not commit, ~100 MB of captures)
/verify/allscreens/
/verify/cmp/
/verify/orig_screens/
/verify/std_screens/
/verify/p2/
/verify/frontend_ref/

