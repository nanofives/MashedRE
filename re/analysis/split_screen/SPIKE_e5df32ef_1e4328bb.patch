         float fwd[3] = {at[0]-eye[0], at[1]-eye[1], at[2]-eye[2]};
-        parts_.Update(dt, eye, fwd, car_ready_ ? car_pos_ : nullptr,
-                      car_ready_ ? car_speed_ : 0.f);
-        parts_.Render(dev, eye, at);
+        // Collision/slide FX (skids + impact sparks) for every car, before the
+        // pool advances this frame.
+        if (advance && car_ready_) {   // emit + advance the pool ONCE per frame
+            EmitCarFx(0, car_pos_, car_vel_, car_speed_, car_yaw_, dt);
+            for (int i = 0; i < static_cast<int>(ai_cars_.size()) && i < 3; ++i)
+                EmitCarFx(i + 1, ai_cars_[i].pos, ai_cars_[i].vel,
+                          ai_cars_[i].cur_speed, ai_cars_[i].yaw, dt);
+        }
+        if (advance)
+            parts_.Update(dt, eye, fwd, car_ready_ ? car_pos_ : nullptr,
+                          car_ready_ ? car_speed_ : 0.f);
+        parts_.Render(dev, eye, at);   // drawn in each viewport
         // power-up orbs (additive glow billboards) on top of the weather
         if (pickups_.enabled()) pickups_.Render(dev, eye, at);
     }
+    };  // end drawView lambda
+
+    if (kViews == 1) {
+        drawView(eye, at, 800.f / 600.f, nullptr, true);   // 1P: full screen, unchanged
+    } else {
+        // Player 2 chase camera on car slot 1 (ai_cars_[0]); mirror the P1 chase cam.
+        float p2eye[3] = { eye[0], eye[1], eye[2] }, p2at[3] = { at[0], at[1], at[2] };
+        if (!ai_cars_.empty()) {
+            const AiCar& c = ai_cars_[0];
+            const float back = 7.f, up = 3.f;
+            p2eye[0] = c.pos[0] - std::cos(c.yaw) * back;
+            p2eye[1] = c.pos[1] + up;
+            p2eye[2] = c.pos[2] - std::sin(c.yaw) * back;
+            p2at[0] = c.pos[0]; p2at[1] = c.pos[1] + 0.8f; p2at[2] = c.pos[2];
+        }
+        const UINT W = fullVp.Width, hh = fullVp.Height / 2;
+        const float aspect = hh ? static_cast<float>(W) / static_cast<float>(hh) : 800.f / 600.f;
+        D3DVIEWPORT9 vpTop{ fullVp.X, fullVp.Y,      W, hh, 0.f, 1.f };
+        D3DVIEWPORT9 vpBot{ fullVp.X, fullVp.Y + hh, W, hh, 0.f, 1.f };
+        drawView(eye,   at,   aspect, &vpTop, true);    // P1 top — advance the pool here
+        drawView(p2eye, p2at, aspect, &vpBot, false);   // P2 bottom — reuse advanced pool
+        dev->SetViewport(&fullVp);                        // restore for the 2D/menu pass
+    }
 
     dev->SetRenderState(D3DRS_FOGENABLE, FALSE);
