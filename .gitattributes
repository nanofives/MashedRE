# Keep pipeline/diag scripts LF — CRLF \r are control chars the Workflow approval
# dialog rejects (see re/diag/KNOWN_ISSUES.md WF-CRLF).
re/pipeline/*.js text eol=lf
re/pipeline/**/*.js text eol=lf
scripts/diag.py text eol=lf
scripts/pipeline_plan.py text eol=lf
scripts/dump_asm.py text eol=lf

# Shell scripts must be LF. core.autocrlf=true is set locally, and with no rule here a
# branch checkout re-materializes every .sh that differs between the two commits with
# CRLF - bash then fails on the first line with "$'\r': command not found". This broke
# 7 of 9 scripts (including ghidra_pool.sh, which every headless Ghidra run depends on)
# during a main<->branch round-trip on 2026-09-11.
*.sh text eol=lf

# Append-only tracker: keep LF whatever tool writes it (merge train 5f335db09 rewrote it CRLF, 2026-10-24).
re/analysis/CHANGELOG.md text eol=lf

# Ledger snapshot files (roadmap.ps1 snapshot copies live log/orch files here): LF whatever core.autocrlf says, so git add never warns (HB-TRAINCLEAN).
re/orchestrator/ledger/** text eol=lf
re/orchestrator/DECISIONS.md text eol=lf
re/orchestrator/INTEGRATION_LOG.md text eol=lf

# hooks.csv: the derived `port` column (L-93, scripts/backfill_port.py) sits on every row, so a branch
# that predates it would conflict on every row it touched. The driver strips `port`, merges the rest
# with git merge-file, and carries `port` back by RVA. Undefined driver = git's normal text merge.
# Register once per clone: git config merge.hooksport.driver "py -3.12 scripts/backfill_port.py --merge-driver %O %A %B"
/hooks.csv merge=hooksport

# Generated port-state files (HB-GENFILES-NOCONFLICT): two ORIG_TOP rows in flight both append to these, so a line
# merge conflicts. scripts/genfiles_merge.py merges by record (BINDINGS by rva, SEED_CANDIDATES and the .inc by
# address), re-renders the .inc through re/tools/gen_portstate_seed.py, and conflicts loudly (markers, exit 1) only
# on a real disagreement. Undefined driver = git's normal text merge.
# Register once per clone: py -3.12 scripts/genfiles_merge.py --install
/verify/porttop_20261108/BINDINGS.tsv merge=genbindings
/verify/portstate_20261108/SEED_CANDIDATES.tsv merge=genseedtsv
/mashedmod/src/mashed_re/Compat/PortStateSeed.inc merge=genseedinc

# Append-only register (run policy 2026-11-16): every branch adds lines at the end; keep both sides on merge.
re/orchestrator/UNCERTAIN_REGISTER.md merge=union

# BIND-PROFILE-DATA (run 54): binder data tables are one record per line, read into sets / dicts (a duplicate line is
# harmless, a line one side deleted stays deleted), so two binding rows that both append keep both sides.
# verify/bindprofile_20261121/RESULT_BIND-PROFILE-DATA.md, merge_probe.txt.
re/tools/bind/state/*/rules.tsv merge=union
re/tools/bind/state/*/roots.txt merge=union
re/tools/bind/state/*/stop_reasons.tsv merge=union
re/tools/bind/state/*/c_hold.txt merge=union
re/tools/bind/state/*/cpp_unclean.txt merge=union
# exe_sources.rsp: the train already unions it (merge_train.json conflict_union); this makes restacks do the same.
mashedmod/exe_sources.rsp merge=union
# dual_copy_allowlist.txt: lint_rva_bodies.py reads it into a dict by entry (parse_allowlist), every entry line is
# unique. The train's keyed merge (tracker_merge3.py allow) exits 2 on this file since the ORIGTOP-ONLY lines
# (463 lines share the first token, duplicate key ORIGTOP-ONLY), so union is the working path.
re/tools/dual_copy_allowlist.txt merge=union
# NOT union (see the RESULT): re/match/PROVISIONAL.tsv (an edited row next to an append is kept twice; key-merge it),
# the generated Match/PortTop_BulkRefs.cpp, Match/PortTop_*Stops.cpp, state/*/plan.json, state/*/newfiles.txt
# (regenerate with porttop_bind.py write / refs on the merged head).
