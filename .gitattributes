# Keep pipeline/diag scripts LF — CRLF \r are control chars the Workflow approval
# dialog rejects (see re/diag/KNOWN_ISSUES.md WF-CRLF).
re/pipeline/*.js text eol=lf
re/pipeline/**/*.js text eol=lf
scripts/diag.py text eol=lf
scripts/pipeline_plan.py text eol=lf
scripts/dump_asm.py text eol=lf

# Shell scripts must be LF. core.autocrlf=true is set locally, and with no rule here a
# branch checkout re-materializes every .sh that differs between the two commits with
# CRLF - bash then fails on the first line with "$'\r': command not found". This broke
# 7 of 9 scripts (including ghidra_pool.sh, which every headless Ghidra run depends on)
# during a main<->branch round-trip on 2026-09-11.
*.sh text eol=lf

# Append-only tracker: keep LF whatever tool writes it (merge train 5f335db09 rewrote it CRLF, 2026-10-24).
re/analysis/CHANGELOG.md text eol=lf

# Ledger snapshot files (roadmap.ps1 snapshot copies live log/orch files here): LF whatever core.autocrlf says, so git add never warns (HB-TRAINCLEAN).
re/orchestrator/ledger/** text eol=lf
re/orchestrator/DECISIONS.md text eol=lf
re/orchestrator/INTEGRATION_LOG.md text eol=lf

# hooks.csv: the derived `port` column (L-93, scripts/backfill_port.py) sits on every row, so a branch
# that predates it would conflict on every row it touched. The driver strips `port`, merges the rest
# with git merge-file, and carries `port` back by RVA. Undefined driver = git's normal text merge.
# Register once per clone: git config merge.hooksport.driver "py -3.12 scripts/backfill_port.py --merge-driver %O %A %B"
/hooks.csv merge=hooksport
